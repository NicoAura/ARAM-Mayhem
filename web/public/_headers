# Static files (served without the app): the same security headers as next.config.ts.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Build files have a hash in their names, so a browser can keep them for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, splashes, models and sounds keep their names across patches: a day fresh, then the old copy
# is shown while the new one loads, for up to a week.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sw.js
  Cache-Control: no-cache
